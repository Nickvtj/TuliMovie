{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|webp|svg|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "buildConfigurations": {
          ".": {
            "projectId": "tulimovie",
            "appId": "1:424657617515:android:829218e93891a19676672e",
            "fileOutput": "android/app/google-services.json"
          }
        }
      },
      "dart": {
        "lib/core/config/firebase_options.dart": {
          "projectId": "tulimovie",
          "configurations": {
            "android": "1:424657617515:android:829218e93891a19676672e",
            "web": "1:424657617515:web:2eb79824fa312ea476672e"
          }
        }
      }
    }
  }
}

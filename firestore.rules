rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;

      match /watched/{movieId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }

    match /matches/{roomId} {
      allow read, write: if signedIn();
      match /swipes/{userId} {
        allow read, write: if signedIn();
      }
    }

    match /watchlist/shared/items/{itemId} {
      allow read, write: if signedIn();
    }

    match /cinepass/{docId} {
      allow read, write: if signedIn();
    }

    match /awards/{year} {
      allow read, write: if signedIn();
      match /votes/{voteId} {
        allow read, write: if signedIn();
      }
    }
  }
}

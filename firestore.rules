rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;

      match /watched/{movieId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      // Quem {userId} segue — só o próprio dono altera.
      match /following/{targetId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == userId && targetId != userId;
      }

      // Espelho: cada seguidor só cria/remove o próprio documento.
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == followerId && followerId != userId;
      }
    }

    // Reserva de @username (id do doc = username). Leitura pública para checar
    // disponibilidade antes do cadastro; nunca muda de dono.
    match /usernames/{username} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Perfis são públicos: qualquer logado lê. Só o autor publica, edita e apaga;
    // os demais só alteram as reações.
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.auth.uid in request.resource.data.audienceIds;
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /matches/{roomId} {
      allow read, write: if signedIn();
      match /swipes/{userId} {
        allow read, write: if signedIn();
      }
    }

    match /watchlist/shared/items/{itemId} {
      allow read, write: if signedIn();
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.createdBy;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      );

      match /watchlist/shared/items/{itemId} {
        allow read, write: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }

    match /awards/{year} {
      allow read, write: if signedIn();
      match /votes/{voteId} {
        allow read, write: if signedIn();
      }
    }
  }
}
